# Runtime mode
APP_ENV=development
AUTO_CREATE_SCHEMA=true
ENABLE_API_DOCS=true

# Local SQLite. Production should use postgresql+psycopg://...
DATABASE_URL=sqlite:///./expense.db
SECRET_KEY=replace-with-a-long-random-value

# Public URL used in password-reset emails
FRONTEND_URL=http://127.0.0.1:8000

# Optional allowed origins when the web frontend is hosted separately from the API
# Leave empty when FastAPI serves the web frontend on the same origin
CORS_ORIGINS=
# Optional comma-separated host allowlist, for example app.example.com
TRUSTED_HOSTS=

# Optional integrations
AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Same backend key; blank disables fallback. Must support Interactions + thinking_level=low.
GEMINI_FALLBACK_MODEL=gemini-3.1-pro-preview
RESEND_API_KEY=
RESEND_FROM_EMAIL=Expense Management AI <onboarding@resend.dev>

# Docker Compose
POSTGRES_PASSWORD=replace-with-a-strong-database-password
APP_PORT=8000
APP_BIND_ADDRESS=127.0.0.1
