@startuml

top to bottom direction
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam dpi 600
skinparam nodesep 18
skinparam ranksep 25
skinparam ArrowThickness 1.6
skinparam shadowing false
skinparam defaultFontColor #111111
skinparam ArrowColor #202020
skinparam usecaseBorderThickness 1.4
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor white
  BorderColor #202020
  ArrowColor #202020
}

actor "Người\nsử dụng" as User <<primary>>
actor "Google\nGemini" as Gemini <<external>>
actor "Resend" as Resend <<external>>

rectangle "Sổ chi tiêu - Tổng quan" {
  package "TÀI KHOẢN" {
    usecase "UC001\nĐăng ký\ntài khoản" as UC001
    usecase "UC002\nĐăng nhập" as UC002
    usecase "UC003\nĐăng xuất" as UC003
    usecase "UC004\nKhôi phục\nmật khẩu" as UC004
    usecase "UC005\nQuản lý hồ sơ" as UC005
  }

  package "QUẢN LÝ TÀI CHÍNH" {
    usecase "UC006\nQuản lý\ndanh mục" as UC006
    usecase "UC007\nQuản lý\ngiao dịch" as UC007
    usecase "UC008\nQuản lý ngân sách" as UC008
    usecase "UC009\nQuản lý mục tiêu\ntiết kiệm" as UC009
  }

  package "PHÂN TÍCH VÀ HỖ TRỢ" {
    usecase "UC010\nXem Dashboard" as UC010
    usecase "UC011\nXem báo cáo\nso sánh" as UC011
    usecase "UC012\nTrợ lý AI" as UC012
  }

}

User -[norank]- UC001
User -[norank]- UC002
User -[norank]- UC003
User -[norank]- UC004
User -[norank]- UC005
User -[norank]- UC006
User -[norank]- UC007
User -[norank]- UC008
User -[norank]- UC009
User -[norank]- UC010
User -[norank]- UC011
User -[norank]- UC012

Gemini -- UC012
Resend -- UC004

UC001 -[hidden]down- UC002
UC002 -[hidden]down- UC003
UC003 -[hidden]down- UC004
UC004 -[hidden]down- UC005
UC006 -[hidden]down- UC007
UC007 -[hidden]down- UC008
UC008 -[hidden]down- UC009
UC010 -[hidden]down- UC011
UC011 -[hidden]down- UC012
UC009 -[hidden]down- UC010
UC003 -[hidden]right- User
User -[hidden]right- UC007
@enduml
