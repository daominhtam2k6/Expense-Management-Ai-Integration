@startuml UC010_Sequence_BaoCaoSoSanh
title UC010 — BIỂU ĐỒ TUẦN TỰ XEM BÁO CÁO SO SÁNH
autonumber
skinparam shadowing false
skinparam sequence {
  ArrowColor #355C57
  LifeLineBorderColor #8AA8A3
  ParticipantBorderColor #087F5B
  ParticipantBackgroundColor #EAF5F1
}

actor "Người dùng" as User
boundary "ReportsPage\n(UI Layer)" as UI
control "ReportsRouter\n(API/Business Layer)" as Router
entity "Transaction\n(Entity)" as Transaction
entity "Category\n(Entity)" as Category
database "Database\n(Data Layer)" as DB

User -> UI : Mở Báo cáo / chọn tháng-năm
UI -> Router : GET /api/reports/?month&year
activate Router
Router -> Router : Xác định kỳ hiện tại\nvà tháng liền trước

Router -> Transaction : _period_totals(current)
Transaction -> DB : SUM income/expense kỳ hiện tại
DB --> Transaction : current totals

Router -> Transaction : _period_totals(previous)
Transaction -> DB : SUM income/expense kỳ trước
DB --> Transaction : previous totals

Router -> Category : _category_totals(current)
Category -> DB : SUM expense + COUNT transaction\nGROUP BY category
DB --> Category : current categories

Router -> Category : _category_totals(previous)
Category -> DB : SUM expense + COUNT transaction\nGROUP BY category
DB --> Category : previous categories

Router -> Router : Tính net, difference,\nshare và change percentage
note right of Router
  Luồng này không gọi Gemini.
end note
Router --> UI : ReportOut
deactivate Router

alt Hai kỳ không có dữ liệu
    UI --> User : Hiển thị hướng dẫn thêm giao dịch
else Có dữ liệu
    UI --> User : Hiển thị tổng quan, biểu đồ,\ncơ cấu, biến động và bảng chi tiết
    opt Người dùng chọn Xem giao dịch
        User -> UI : Chọn một danh mục
        UI -> UI : Điều hướng /transactions\n?period&type=expense&category_id
        UI --> User : Mở danh sách đã lọc
    end
else API lỗi
    UI --> User : Hiển thị lỗi và Thử lại
end
@enduml
